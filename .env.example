# Copy to .env and fill in. The agent will not start without these.
#   cp .env.example .env

# --- Alpaca paper trading (required) -------------------------------------
# From https://app.alpaca.markets → Paper Trading → API Keys.
# Paper only. Never point this at a live account.
APCA_API_KEY_ID=PK...
APCA_API_SECRET_KEY=...

# --- Featherless (required for the practitioner and the calibration study) -
# From https://featherless.ai → API keys. Open-weight models behind an
# OpenAI-compatible endpoint.
FEATHERLESS_API_KEY=...

# --- Optional overrides ---------------------------------------------------
# FEATHERLESS_MODELS=moonshotai/Kimi-K2.6,openai/gpt-oss-120b,Qwen/Qwen3-235B-A22B
# SAADHAK_LLM=live            # live | mock (recorded fixtures, for development)
# SAADHAK_LLM_BUDGET_USD=6.00 # hard cap, metered from response usage
# SAADHAK_SYMBOLS=SPY,QQQ     # pin the universe; omit to let the screen choose
# SAADHAK_DRY_RUN=false
